+(with-test (:name (:float-print :prin1 :known-outputs))
+  (let ((*read-default-float-format* 'single-float))
+    (dolist (case *float-print-prin1-cases*)
+      (destructuring-bind (spec expected) case
+        (let ((x (float-print-test-value spec)))
+          (dolist (*print-pretty* '(nil t))
+            (assert (string= (prin1-to-string x) expected))
+            (assert (string= (princ-to-string x) expected))
+            (assert (string= (with-output-to-string (s) (prin1 x s)) expected))
+            (assert (string= (write-to-string x :readably nil) expected))))))))
+
