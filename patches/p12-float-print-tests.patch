+    ((:s 964689920) "2.4414063f-4")
+    ((:s 1210557032) "171657.63f0")
+    ))
+
+(with-test (:name (:float-print :prin1 :double-float-default))
+  (let ((*read-default-float-format* 'double-float))
+    (dolist (case *float-print-double-default-cases*)
+      (destructuring-bind (spec expected) case
+        (assert (string= (prin1-to-string (float-print-test-value spec))
+                         expected))))))
+
+(with-test (:name (:float-print :prin1 :special-values))
+  (let ((*read-default-float-format* 'single-float))
+    (assert (string= (prin1-to-string 0.0) "0.0"))
+    (assert (string= (prin1-to-string -0.0) "-0.0"))
+    (assert (string= (prin1-to-string 0d0) "0.0d0"))
+    (assert (string= (prin1-to-string -0d0) "-0.0d0"))
+    (let ((*read-eval* t))
+      (dolist (x (list single-float-positive-infinity
+                       double-float-negative-infinity))
+        (assert (string= (prin1-to-string x)
+                         (with-output-to-string (s) (prin1 x s))))))))
+
+(with-test (:name (:float-print :prin1 :pprint-dispatch))
+  ;; A pprint dispatch entry for floats wins when pretty printing, also
+  ;; through PRIN1-TO-STRING's fast path, and is ignored otherwise.
+  (let ((*print-pprint-dispatch* (copy-pprint-dispatch))
+        (*read-default-float-format* 'single-float))
+    (set-pprint-dispatch 'float (lambda (s x) (format s "<~,2F>" x)))
+    (let ((*print-pretty* t))
+      (assert (string= (prin1-to-string 1.5) "<1.50>"))
+      (assert (string= (princ-to-string 2d0) "<2.00>")))
+    (let ((*print-pretty* nil))
+      (assert (string= (prin1-to-string 1.5) "1.5")))))
+
+(with-test (:name (:float-print :prin1 :round-trip))
+  (let ((state (sb-ext:seed-random-state 1))
+        (*read-default-float-format* 'single-float))
+    (dotimes (i 20000)
+      (let* ((x (float-print-random-float state))
+             (string (prin1-to-string x)))
+        (assert (eql (read-from-string string) x))
+        (assert (string= string (with-output-to-string (s) (prin1 x s))))))))
+
+(with-test (:name (:float-print :shortest-and-closest))
+  (let ((state (sb-ext:seed-random-state 2)))
+    (flet ((check (x)
+             (let ((x (abs x)))
+               (multiple-value-bind (k digits) (sb-impl::flonum-to-digits x)
+                 (let ((problem (float-print-digits-problem x k digits)))
+                   ;; Without zmij (32-bit platforms), subnormals still get
+                   ;; Burger-Dybvig's longer digits; they must read back.
+                   #-64-bit
+                   (when (and (equal problem "not shortest")
+                              (< x (etypecase x
+                                     (single-float least-positive-normalized-single-float)
+                                     (double-float least-positive-normalized-double-float))))
+                     (setq problem nil))
+                   (when problem
+                     (error "~S: ~A (~D ~S)" x problem k digits)))))))
+      (dotimes (i 5000)
+        (check (float-print-random-float state)))
+      ;; Subnormals: with zmij the output is shorter than before, so they
+      ;; are checked by the oracle rather than against recorded strings.
+      (loop for i from 1 to 200
+            do (check (* i least-positive-double-float))
+               (check (* i least-positive-single-float))
+               (let ((x (sb-kernel:make-double-float (random (ash 1 20) state)
+                                                     (random (ash 1 32) state))))
+                 (unless (zerop x) (check x)))
+               (check (sb-kernel:make-single-float (1+ (random (ash 1 23) state))))))))
+
