+(with-test (:name (:float-print format :float-directives :known-outputs))
+  (let ((*read-default-float-format* 'single-float))
+    (loop for (control spec expected-spec) in *float-print-format-cases*
+          for i from 0
+          for x = (float-print-test-value spec)
+          for expected = (float-print-expected-string expected-spec)
+          do ;; The control string is not a constant here, so FORMAT
+             ;; interprets it.
+             (assert (string= (format nil control x) expected))
+             ;; Every 10th case also through a compiled constant control
+             ;; string (the FORMAT compiler macro).
+             (when (zerop (mod i 10))
+               (assert (string= (funcall (compile nil `(lambda (x)
+                                                         (format nil ,control x)))
+                                         x)
+                                expected))))))
+
+(with-test (:name (:float-print format :float-directives :read-back))
+  ;; ~,6F keeps the value: reading the output back gives a number within
+  ;; half a unit in the sixth decimal (plus the error of reading back).
+  (let ((state (sb-ext:seed-random-state 3)))
+    (dotimes (i 2000)
+      (let* ((x (* (if (zerop (random 2 state)) 1 -1)
+                   (expt 10d0 (- (random 12d0 state) 4))))
+             (f (let ((*read-default-float-format* 'double-float))
+                  (read-from-string (format nil "~,6F" x)))))
+        ;; Half a unit at 6 decimals, plus the error of reading back.
+        (assert (<= (abs (- (rational f) (rational x))) 1/1000000))))))
