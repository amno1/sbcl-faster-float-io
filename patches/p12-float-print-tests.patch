+;;;; absolutely no warranty. See the COPYING and CREDITS files for
+;;;; more information.
+
+;;; The tables of expected output were recorded from SBCL's printer
+;;; before zmij (Burger-Dybvig), so they check that output is unchanged.
+;;; Floats are given as bit patterns: (:D high-bits low-bits) for a
+;;; double, (:S bits) for a single. Other numbers are given as themselves.
+;;; Long expected strings are given in run-length form (see
+;;; FLOAT-PRINT-EXPECTED-STRING).
+
+(defun float-print-test-value (spec)
+  (if (consp spec)
+      (ecase (car spec)
+        (:d (sb-kernel:make-double-float (second spec) (third spec)))
+        (:s (sb-kernel:make-single-float (second spec))))
+      spec))
+
+;;; An expected output: a string, or (:RUN PREFIX CHAR COUNT SUFFIX) for
+;;; PREFIX, COUNT copies of CHAR and SUFFIX (used for the hundreds of
+;;; zeros of very large or small numbers in fixed notation).
+(defun float-print-expected-string (expected)
+  (if (stringp expected)
+      expected
+      (destructuring-bind (prefix char count suffix) (rest expected)
+        (concatenate 'string prefix (make-string count :initial-element char)
+                     suffix))))
+
+;;; Exact oracle for shortest round-trip digits, independent of any
+;;; printing algorithm. Return NIL if K and DIGITS (FLONUM-TO-DIGITS's
+;;; values for positive X) are correct, otherwise a description: the
+;;; digits must read back as X, no shorter decimal may, and no decimal of
+;;; the same length may be closer.
+(defun float-print-digits-problem (x k digits)
+  (labels ((reads-back-p (m e)
+             (and (plusp m)
+                  (handler-case (= x (coerce (* m (expt 10 e)) (type-of x)))
+                    (floating-point-overflow () nil)))))
+    (let* ((n (length digits))
+           (m (parse-integer digits))
+           (e (- k n))
+           (r (rational x)))
+      (cond ((char= (char digits (1- n)) #\0)
+             "trailing zero")
+            ((not (reads-back-p m e))
+             "does not read back")
+            ((and (> n 1)
+                  (loop for e2 in (list (1+ e) (+ e 2))
+                        for q = (/ r (expt 10 e2))
+                        thereis (or (reads-back-p (floor q) e2)
+                                    (reads-back-p (ceiling q) e2))))
+             "not shortest")
+            ((let* ((q (/ r (expt 10 e)))
+                    (best (min (- q (floor q)) (- (ceiling q) q))))
+               (and (reads-back-p (floor q) e)
+                    (reads-back-p (ceiling q) e)
+                    (> (abs (- q m)) best)))
+             "not closest")))))
+
+;;; A random finite float from random bits. NaN and infinity bit patterns
+;;; (all-ones exponent) are rejected before a float is made: on x86 the
+;;; x87 FPU traps on merely loading a signalling NaN.
+(defun float-print-random-float (state)
+  (if (zerop (random 2 state))
+      (loop for high = (- (random (ash 1 32) state) (ash 1 31))
+            unless (= (ldb (byte 11 20) high) #x7FF)
+              return (sb-kernel:make-double-float high (random (ash 1 32) state)))
+      (loop for bits = (- (random (ash 1 32) state) (ash 1 31))
+            unless (= (ldb (byte 8 23) bits) #xFF)
+              return (sb-kernel:make-single-float bits))))
+
