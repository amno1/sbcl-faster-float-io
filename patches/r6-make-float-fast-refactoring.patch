From 0ed76962b537dbe4eee18cf3bd6d6faec57484de Mon Sep 17 00:00:00 2001
From: arthur <arthur.miller@live.com>
Date: Sat, 10 Oct 2026 22:33:47 +0200
Subject: [PATCH 6/7] A slight refactoring of make-float/fast

---
 src/code/reader.lisp | 131 +++++++++++++++++++++----------------------
 1 file changed, 65 insertions(+), 66 deletions(-)

diff --git a/src/code/reader.lisp b/src/code/reader.lisp
index 0ba06fc49..3a3c67cf2 100644
--- a/src/code/reader.lisp
+++ b/src/code/reader.lisp
@@ -1869,73 +1869,72 @@ extended <package-name>::<form-in-package> syntax."
   (let* ((string (token-buf-string buf))
          (end (token-buf-fill-ptr buf))
          (i 0)
-         (negative nil)
-         (w 0)
-         (significant 0)
-         (fraction-digits 0)
-         (dot nil)
-         (exponent 0)
          (format *read-default-float-format*))
-    (declare (type index i end)
-             (type (unsigned-byte 64) w)
-             (type (integer 0 20) significant)
-             (type fixnum fraction-digits exponent))
-    (flet ((char-at (i) (char string i)))
-      (declare (inline char-at))
-      (when (and (< i end) (member (char-at i) '(#\+ #\-)))
-        (setq negative (char= (char-at i) #\-))
-        (incf i))
-      ;; The significand.
-      (loop while (< i end)
-            do (let ((c (char-at i)))
-                 (cond ((char<= #\0 c #\9)
-                        (unless (and (zerop w) (char= c #\0))
-                          (when (= significant 19)
-                            (return-from make-float/fast nil))
-                          (incf significant)
-                          (setq w (+ (* w 10) (- (char-code c) (char-code #\0)))))
-                        (when dot
-                          (incf fraction-digits)))
-                       ((and (char= c #\.) (not dot))
-                        (setq dot t))
-                       (t (return))))
-               (incf i))
-      ;; The exponent.
-      (when (< i end)
-        (setq format (case (char-upcase (char-at i))
-                       (#\E *read-default-float-format*)
-                       ((#\S #\F) 'single-float)
-                       ((#\D #\L) 'double-float)
-                       (t (return-from make-float/fast nil))))
-        (incf i)
-        (let ((exponent-negative nil)
-              (digits 0))
-          (declare (type fixnum digits))
-          (when (and (< i end) (member (char-at i) '(#\+ #\-)))
-            (setq exponent-negative (char= (char-at i) #\-))
-            (incf i))
-          (loop while (< i end)
-                do (let ((c (char-at i)))
-                     (unless (char<= #\0 c #\9)
-                       (return-from make-float/fast nil))
-                     (setq exponent (+ (* exponent 10) (- (char-code c) (char-code #\0))))
-                     (when (> exponent 100000)
-                       (return-from make-float/fast nil))
-                     (incf digits)
-                     (incf i)))
-          (when (zerop digits)
-            (return-from make-float/fast nil))
-          (when exponent-negative
-            (setq exponent (- exponent)))))
-      (let ((double (case format
-                      ((double-float #-long-float long-float) t)
-                      ((single-float short-float) nil)
-                      (t (return-from make-float/fast nil))))
-            (q (- exponent fraction-digits)))
-        (let ((value (or (decimal-to-float w q double)
-                         (return-from make-float/fast nil))))
-          (if negative (- value) value))))))
-)
+    (declare (type index i end))
+    (labels ((char-at (i) (char string i))
+             (negativep () ;; t if negative, nil if positive
+               (when (< i end)
+                 (let ((c (char-at i)))
+                   (when (or (eql c #\+) (eql c #\-))
+                     (incf i))
+                   (eql c #\-)))))
+      (declare (inline char-at negativep))
+      (let ((negative (negativep))
+            (w 0)
+            (significant 0)
+            (fraction-digits 0)
+            (dot nil)
+            (exponent 0))
+        (declare (type (unsigned-byte 64) w)
+                 (type (integer 0 20) significant)
+                 (type fixnum fraction-digits exponent))
+        ;; The significand.
+        (loop while (< i end)
+              do (let ((c (char-at i)))
+                   (cond ((char<= #\0 c #\9)
+                          (unless (and (zerop w) (char= c #\0))
+                            (when (= significant 19)
+                              (return-from make-float/fast nil))
+                            (incf significant)
+                            (setq w (+ (* w 10) (- (char-code c) (char-code #\0)))))
+                          (when dot
+                            (incf fraction-digits)))
+                         ((and (char= c #\.) (not dot))
+                          (setq dot t))
+                         (t (return))))
+                 (incf i))
+        ;; The exponent.
+        (when (< i end)
+          (setq format (case (char-upcase (char-at i))
+                         (#\E *read-default-float-format*)
+                         ((#\S #\F) 'single-float)
+                         ((#\D #\L) 'double-float)
+                         (t (return-from make-float/fast nil))))
+          (incf i)
+          (let ((exponent-negative (negativep))
+                (digits 0))
+            (declare (type fixnum digits))
+            (loop while (< i end)
+                  do (let ((c (char-at i)))
+                       (unless (char<= #\0 c #\9)
+                         (return-from make-float/fast nil))
+                       (setq exponent (+ (* exponent 10) (- (char-code c) (char-code #\0))))
+                       (when (> exponent 100000)
+                         (return-from make-float/fast nil))
+                       (incf digits)
+                       (incf i)))
+            (when (zerop digits)
+              (return-from make-float/fast nil))
+            (when exponent-negative
+              (setq exponent (- exponent)))))
+        (let ((double (case format
+                        ((double-float #-long-float long-float) t)
+                        ((single-float short-float) nil)
+                        (t (return-from make-float/fast nil))))
+              (q (- exponent fraction-digits)))
+          (let ((value (or (decimal-to-float w q double)
+                           (return-from make-float/fast nil))))
+            (if negative (- value) value))))))))
 
 (defun make-float (stream)
   ;; Assume that the contents of *read-buffer* are a legal float, with nothing
-- 
