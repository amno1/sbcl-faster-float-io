From 321e0f71dfb3c5a4f171c9f1dd8fa5c74e998725 Mon Sep 17 00:00:00 2001
From: arthur <arthur.miller@live.com>
Date: Fri, 9 Oct 2026 05:19:37 +0200
Subject: [PATCH 4/5] Add tests for reading floats and SB-EXT:PARSE-FLOAT

tests/float-parse.pure.lisp: the reader's fast path against its exact
code, SB-EXT:PARSE-FLOAT against READ-FROM-STRING and an exact
reference, and PARSE-FLOAT's PARSE-INTEGER-like interface. Numbers too
large for their format must signal an error, or give infinity on
platforms that don't trap floating-point overflow (ARM).
---
 tests/float-parse.pure.lisp | 648 ++++++++++++++++++++++++++++++++++++
 1 file changed, 648 insertions(+)
 create mode 100644 tests/float-parse.pure.lisp

diff --git a/tests/float-parse.pure.lisp b/tests/float-parse.pure.lisp
new file mode 100644
index 000000000..f64e73a03
--- /dev/null
+++ b/tests/float-parse.pure.lisp
@@ -0,0 +1,648 @@
+;;;; Tests of reading floats: the reader's Eisel-Lemire fast path in
+;;;; MAKE-FLOAT (src/code/reader.lisp) and SB-EXT:PARSE-FLOAT.
+
+;;;; This software is part of the SBCL system. See the README file for
+;;;; more information.
+;;;;
+;;;; While most of SBCL is derived from the CMU CL system, the test
+;;;; files (like this one) were written from scratch after the fork
+;;;; from CMU CL.
+;;;;
+;;;; This software is in the public domain and is provided with
+;;;; absolutely no warranty. See the COPYING and CREDITS files for
+;;;; more information.
+
+;;; The table of expected values was recorded from SBCL's reader before
+;;; the fast path (exact rational arithmetic), so it checks that results
+;;; are unchanged. Floats are given as bit patterns: (:D high-bits
+;;; low-bits) for a double, (:S bits) for a single; :ERROR means the
+;;; number does not fit the float format. Such a number signals an error
+;;; where the floating-point overflow trap is enabled, and gives an
+;;; infinity where it is not (e.g. on ARM), with or without the fast path;
+;;; FLOAT-PARSE-OVERFLOW-OK accepts both.
+
+(defun float-parse-overflow-ok (got)
+  (or (eq got :error)
+      (and (consp got)
+           (sb-ext:float-infinity-p
+            (if (eq (car got) :d)
+                (sb-kernel:make-double-float (second got) (third got))
+                (sb-kernel:make-single-float (second got)))))))
+
+(defun float-parse-matches (got expected)
+  (if (eq expected :error)
+      (float-parse-overflow-ok got)
+      (equal got expected)))
+
+(defun float-parse-test-value (spec)
+  (ecase (car spec)
+    (:d (sb-kernel:make-double-float (second spec) (third spec)))
+    (:s (sb-kernel:make-single-float (second spec)))))
+
+(defun float-parse-bits (x)
+  (etypecase x
+    (double-float (list :d (sb-kernel:double-float-high-bits x)
+                        (sb-kernel:double-float-low-bits x)))
+    (single-float (list :s (sb-kernel:single-float-bits x)))))
+
+;;; A random finite float from random bits, both signs, subnormals
+;;; included. NaN and infinity bit patterns are rejected before a float is
+;;; made: on x86 the x87 FPU traps on merely loading a signalling NaN.
+(defun float-parse-random-float (state)
+  (if (zerop (random 2 state))
+      (loop for high = (- (random (ash 1 32) state) (ash 1 31))
+            unless (= (ldb (byte 11 20) high) #x7FF)
+              return (sb-kernel:make-double-float high (random (ash 1 32) state)))
+      (loop for bits = (- (random (ash 1 32) state) (ash 1 31))
+            unless (= (ldb (byte 8 23) bits) #xFF)
+              return (sb-kernel:make-single-float bits))))
+
+;;; The exact value of a decimal float token (sign, digits, optional point,
+;;; optional exponent with a marker) as a rational, and its float format,
+;;; independently of SBCL's parsers.
+(defun float-parse-exact (string)
+  (let* ((negative (char= (char string 0) #\-))
+         (s (string-left-trim "+-" string))
+         (epos (position-if (lambda (c) (find (char-upcase c) "ESFDL")) s))
+         (mantissa (subseq s 0 epos))
+         (exponent (if epos (parse-integer s :start (1+ epos)) 0))
+         (format (if epos
+                     (ecase (char-upcase (char s epos))
+                       (#\E *read-default-float-format*)
+                       ((#\S #\F) 'single-float)
+                       ((#\D #\L) 'double-float))
+                     *read-default-float-format*))
+         (dot (position #\. mantissa))
+         (digits (remove #\. mantissa))
+         (fraction (if dot (- (length mantissa) dot 1) 0))
+         (value (* (parse-integer digits) (expt 10 (- exponent fraction)))))
+    (values (if negative (- value) value) format negative)))
+
+(defun float-parse-random-token (state)
+  (let* ((n (1+ (random (if (zerop (random 4 state)) 25 19) state)))
+         (digits (let ((d (make-string n)))
+                   (dotimes (i n d)
+                     (setf (char d i) (digit-char (random 10 state))))))
+         (point (random n state))
+         (mantissa (concatenate 'string
+                                (case (random 3 state) (0 "-") (1 "+") (t ""))
+                                (subseq digits 0 point) "." (subseq digits point))))
+    (if (zerop (random 3 state))
+        mantissa
+        (format nil "~A~C~D" mantissa (char "eEdDfFsSlL" (random 10 state))
+                (- (random 701 state) 350)))))
+
