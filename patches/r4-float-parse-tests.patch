+(with-test (:name (:float-parse :reader :known-values))
+  (loop for (string format expected) in *float-parse-cases*
+        do (let* ((*read-default-float-format* format)
+                  (got (handler-case (float-parse-bits (read-from-string string))
+                         (reader-error () :error))))
+             (assert (float-parse-matches got expected)))))
+
+(with-test (:name (:float-parse sb-ext:parse-float :known-values))
+  ;; The same values as the reader, a PARSE-ERROR where the reader
+  ;; signals a READER-ERROR.
+  (loop for (string format expected) in *float-parse-cases*
+        do (let* ((*read-default-float-format* format)
+                  (got (handler-case (float-parse-bits (sb-ext:parse-float string))
+                         (parse-error () :error))))
+             (assert (float-parse-matches got expected)))))
+
+(with-test (:name (:float-parse :round-trip))
+  (let ((state (sb-ext:seed-random-state 11)))
+    (dolist (*read-default-float-format* '(single-float double-float))
+      (dotimes (i 20000)
+        (let* ((x (float-parse-random-float state))
+               (string (prin1-to-string x)))
+          (assert (eql (read-from-string string) x))
+          (assert (eql (sb-ext:parse-float string) x)))))))
+
+(with-test (:name (:float-parse :correctly-rounded))
+  ;; Random tokens with up to 25 digits and exponents up to +-350: both
+  ;; the reader and PARSE-FLOAT give the exact value rounded to the float
+  ;; format, or an error if it does not fit. As in the reader, the
+  ;; magnitude is converted and the sign applied afterwards, so a negative
+  ;; value that rounds to zero gives -0.0.
+  (let ((state (sb-ext:seed-random-state 12)))
+    (dolist (*read-default-float-format* '(single-float double-float))
+      (dotimes (i 20000)
+        (let* ((string (float-parse-random-token state))
+               (expected (multiple-value-bind (value format negative)
+                             (float-parse-exact string)
+                           (handler-case
+                               (let ((x (coerce (abs value) format)))
+                                 (float-parse-bits (if negative (- x) x)))
+                             (arithmetic-error () :error))))
+               (read (handler-case (float-parse-bits (read-from-string string))
+                       (reader-error () :error)))
+               (parsed (handler-case (float-parse-bits (sb-ext:parse-float string))
+                         (parse-error () :error))))
+          (assert (float-parse-matches read expected))
+          (assert (float-parse-matches parsed expected)))))))
+
+(with-test (:name (:float-parse sb-ext:parse-float :interface))
+  ;; (string arguments value index), (string arguments :error), or
+  ;; (string arguments :overflow): an error or an infinity (see above).
+  (let ((*read-default-float-format* 'single-float))
+    (loop for (string args . expected)
+            in '(("1.5" () 1.5 3) ("  1.5  " () 1.5 7) ("+1.5" () 1.5 4)
+                 ("-1.5" () -1.5 4) ("12" () 12.0 2) ("12." () 12.0 3)
+                 (".5" () 0.5 2) ("1e3" () 1000.0 3) ("2d3" () 2000d0 3)
+                 ("1.5s0" () 1.5 5) ("1.5l0" () 1.5d0 5) ("1.5F0" () 1.5 5)
+                 ("-0.0" () -0.0 4)
+                 ("1.5x" () :error) ("1.5x" (:junk-allowed t) 1.5 3)
+                 ("1.5 x" () :error) ("1.5 x" (:junk-allowed t) 1.5 3)
+                 ("1.5e" () :error) ("1.5e" (:junk-allowed t) 1.5 3)
+                 ("1.5e+" (:junk-allowed t) 1.5 3) ("1.5ex" (:junk-allowed t) 1.5 3)
+                 ("" () :error) ("" (:junk-allowed t) nil 0)
+                 ("   " () :error) ("   " (:junk-allowed t) nil 3)
+                 ("x" () :error) ("x" (:junk-allowed t) nil 0)
+                 ("-" () :error) ("-" (:junk-allowed t) nil 1)
+                 ("." () :error) ("1.2.3" () :error) ("1.2.3" (:junk-allowed t) 1.2 3)
+                 ("1d309" () :overflow) ("1e39" () :overflow)
+                 ("x1.5y" (:start 1 :end 4) 1.5 4) ("x1.5y" (:start 1) :error)
+                 ("x1.5y" (:start 1 :junk-allowed t) 1.5 4) ("1.5" (:end 1) 1.0 1)
+                 ("  2.5" (:start 0 :end 5) 2.5 5))
+          do (multiple-value-bind (value index)
+                 (handler-case (apply #'sb-ext:parse-float string args)
+                   (parse-error () (values :error nil)))
+               (case (first expected)
+                 (:error (assert (eq value :error)))
+                 (:overflow (assert (or (eq value :error)
+                                        (and (floatp value)
+                                             (sb-ext:float-infinity-p value)))))
+                 (t (assert (and (eql value (first expected))
+                                 (eql index (second expected))))))))))
+
+(with-test (:name (:float-parse sb-ext:parse-float :non-simple-strings))
+  (let ((*read-default-float-format* 'single-float)
+        (fill (make-array 10 :element-type 'character :fill-pointer 5
+                             :initial-contents "  4.5 junk"))
+        (displaced (make-array 6 :element-type 'character
+                                 :displaced-to (copy-seq "xx 3.25 yy")
+                                 :displaced-index-offset 2)))
+    (multiple-value-bind (value index) (sb-ext:parse-float fill)
+      (assert (and (eql value 4.5) (eql index 5))))
+    (multiple-value-bind (value index) (sb-ext:parse-float displaced :junk-allowed t)
+      (assert (and (eql value 3.25) (eql index 5))))
+    (multiple-value-bind (value index)
+        (sb-ext:parse-float (coerce "1.25" 'simple-base-string))
+      (assert (and (eql value 1.25) (eql index 4))))))
